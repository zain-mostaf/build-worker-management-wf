# Copy this file to terraform.tfvars and replace every REPLACE_* value.
# Keep terraform.tfvars out of source control because it contains credentials.

ibmcloud_api_key     = "REPLACE_WITH_IBM_CLOUD_API_KEY"
symphony_admin_password = "REPLACE_WITH_SYMPHONY_ADMIN_PASSWORD"
cluster_prefix       = "REPLACE_WITH_CLUSTER_PREFIX"
zone                 = "REPLACE_WITH_PRIMARY_ZONE"
vpc_name             = "REPLACE_WITH_VPC_NAME"
# The resource group and VPC must already exist in the IBM Cloud account.
resource_group_name  = "REPLACE_WITH_RESOURCE_GROUP_NAME"
existing_ssh_key_name = "REPLACE_WITH_EXISTING_SSH_KEY_NAME"
# Sensitive value: provide the private key matching existing_ssh_key_name via Schematics.
deployment_private_key = "REPLACE_WITH_EXISTING_SSH_PRIVATE_KEY"
ssh_keys             = []

# IBM Cloud DNS Services instance and private zone.
# Terraform manages A records and PTR records for every VSI.
private_dns_instance_name = "REPLACE_WITH_DNS_INSTANCE_NAME"
private_dns_zone_name     = "REPLACE_WITH_PRIVATE_DNS_ZONE_NAME"

grid_manager_definition = {
  prefix_name      = "grid-man"
  server_type      = "shared"
  quantity         = 3
  primary_ip_offset = 5
  instance_profile = "mx2-32x256-cl"
  image_name       = "r014-6fb53289-e071-49bb-af78-269762b46539"

  worker_os        = "windows"

  subnets = [
    {
      key                  = "internal-subnet"
      name                 = "REPLACE_WITH_SUBNET_NAME"
      exists               = true
      subnet_section_cidrs = ["10.136.64.0/22"]
    }
  ]

  symphony_config_info = {
    sym_cluster_id      = "REPLACE_WITH_SYMPHONY_CLUSTER_ID"
    ego_base_port       = 9100
    ego_ssl_setup       = true
    ego_ssl_port        = 9114
    ego_ssm_range       = "9120-9199"
    post_deployment_tasks = ""
  }

  # Leave certificate values empty to use the module's certificate generation.
  # Supply PEM values here only when using customer-managed certificates.
  symphony_certificates = {
    ca_intermediate_pem = ""
    ca_certificate_pem  = ""
    soam_certificate_pem = ""
    soam_private_key_pem = ""
    webgui_certificate_pem = ""
  }

  placement_group = {
    key    = "placement-group"
    exists = false
    name   = "REPLACE_WITH_PLACEMENT_GROUP_NAME"
    type   = "host_spread"
  }

  security_groups = [
    {
      name   = "REPLACE_WITH_SYMPHONY_SECURITY_GROUP_NAME"
      exists = true
    },
    {
      name   = "REPLACE_WITH_ALLOW_ALL_SECURITY_GROUP_NAME"
      exists = true
    }
  ]

  data_volumes = []
}

nfs_storage_definition = {
  key                    = "nfs-storage"
  nfs_prefix_name        = "nfs-storage"
  nfs_storage_size       = 100
  nfs_storage_iops       = 0
  nfs_replica_zone       = "REPLACE_WITH_REPLICA_ZONE"
  mount_points = [
    {
      key                       = "data"
      name                      = "data"
      nfs_storage_ip            = "REPLACE_WITH_NFS_IP"
      # This subnet must already exist; the NFS mount-point module looks it up.
      nfs_storage_subnet_name   = "REPLACE_WITH_EXISTING_NFS_SUBNET_NAME"
      security_groups = [
        {
          name   = "REPLACE_WITH_NFS_SECURITY_GROUP_NAME"
          exists = true
        }
      ]
    }
  ]
}
