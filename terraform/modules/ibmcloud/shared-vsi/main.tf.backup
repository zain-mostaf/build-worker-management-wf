locals {
    machine_ip_name_mapping = var.machine_ip_name_mapping
    symphony_image_id = var.symphony_image_name
    symphony_profile = var.symphony_profile
    security_groups = var.security_group_ids
    zone = var.zone
    vpc_id = var.vpc_id
    resource_group_id = var.resource_group_id
    ssh_keys = var.ssh_keys
    cloud_init_script = var.cloud_init_script
    tags = var.tags
    subnet_definition = var.subnet_definition

    placement_group_id = var.placement_group_id

    // List all primary IPs in a list. This will be used to determine the machine number being provisioned - therefore, the 
    // IP to be selected for each additional subnet declared
    ips_list = [for ip, name in local.machine_ip_name_mapping : ip ]

    // list of IPs based on assigned_cidr attribute (list). It will be used to determine the next IP for the next grid manager for each additional subnet
    // Object example:
    // for a subnet with 2 assigned CIDRs for 10.200.0.6/31 and 10.200.0.8/30, the object would be:
    // "subnet_id" => available_ips = ["10.200.0.6", "10.200.0.7", "10.200.0.8", "10.200.0.9", "10.200.0.10", "10.200.0.11"]
    other_networks_available_ips = {for i in range(1, length(local.subnet_definition)) : local.subnet_definition[i].subnet_id => {
         available_ips = flatten([for cidr in local.subnet_definition[i].assigned_cidr : [for index in range(pow(2, 32 - split("/", cidr)[1])) : cidrhost(cidr, index)]])
    }}

}

data ibm_is_image image_by_name {
    count = length(regexall("\\w{4}-\\w{8}-\\w{4}-\\w{4}-\\w{4}-\\w{12}", local.symphony_image_id)) == 0 ? 1 : 0
    name = local.symphony_image_id
}

resource "ibm_is_instance" "vsi" {
 
  for_each       = local.machine_ip_name_mapping
  name           = each.value
  image          = try(data.ibm_is_image.image_by_name[0].id, local.symphony_image_id)
  profile         = local.symphony_profile
  vpc            = local.vpc_id
  zone           = local.zone
  keys           = local.ssh_keys
  resource_group = local.resource_group_id
  user_data      = replace(local.cloud_init_script, "__COMPUTERNAME__", each.value)

// try to get the placement group from placement_groups_structure object or unset this parameter
  placement_group = local.placement_group_id

  tags           = concat(local.tags)

  metadata_service {
    enabled = true
  }

  primary_network_interface {
    name                 = "eth0"
    subnet               = local.subnet_definition[0].subnet_id
    security_groups      = local.security_groups
    
    primary_ip{
      address = each.key
      auto_delete = true
      name = "${each.value}-eth0"
    }
  }

  // dynamic allocation of subnets (the first in this list will be used for MultiHome configuration)
  dynamic  "network_interfaces" {
     for_each = {for index in range(1, length(local.subnet_definition)) : local.subnet_definition[index].subnet_id => {
         subnet_id = local.subnet_definition[index].subnet_id,
         index = index,
         // IP consumed from the other_network_available_ips list. Offset comes from external configuration to deal with multiple 
         // module calls to the same CIDR (ex: primary/other_managers)
         ip = local.other_networks_available_ips[local.subnet_definition[index].subnet_id].available_ips[index(local.ips_list, each.key) + local.subnet_definition[index].offset]
     }}
     content {
       name = "eth${network_interfaces.value.index}"
       subnet = network_interfaces.value.subnet_id
       security_groups = local.security_groups
       primary_ip {
          name = "${each.value}-eth${network_interfaces.value.index}"
          auto_delete = true
          address = network_interfaces.value.ip
       }
     }
  }
  
  lifecycle {
      ignore_changes = [ user_data, tags, image ]
  }

  boot_volume {
      name = "${each.value}-boot"
      size = 150
  }
  
  // Data volumes (later)

}
